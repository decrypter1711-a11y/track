# Copy these as Environment Variables in your Vercel project settings
# (Project -> Settings -> Environment Variables). Do NOT commit a real
# .env file with real secrets to GitHub.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGO_URI=mongodb+srv://vaibhavjain:CNgsMCp8teQ2eucy@cluster0.pkquxad.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Long random string used to sign session cookies.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=replace-with-a-long-random-string

# Admin console login (change these from the defaults!)
ADMIN_USERNAME=choose-an-admin-username
ADMIN_PASSWORD=choose-a-strong-admin-password

# Set to 1 once your Vercel domain is served over HTTPS (it always is)
COOKIE_SECURE=1
